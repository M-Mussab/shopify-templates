{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<section class="team-slider-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="team-slider-header">
      {% if section.settings.overline_text %}
        <p
          class="overline"
          style="
            font-family: {{ section.settings.overline_font_family }};
            font-size: {{ section.settings.overline_size }}px;
            font-weight: {{ section.settings.overline_weight }};
            color: {{ section.settings.overline_color }};
            margin: 0 0 8px;
          "
        >
          {{ section.settings.overline_text }}
        </p>
      {% endif %}

      <div class="heading-row">
        {% if section.settings.heading_text %}
          <h2
            class="title"
            style="
              font-family: {{ section.settings.heading_font_family }};
              font-size: {{ section.settings.heading_size }}px;
              font-weight: {{ section.settings.heading_weight }};
              color: {{ section.settings.heading_color }};
              margin: 0;
            "
          >
            {{ section.settings.heading_text }}
          </h2>
        {% endif %}

        <div class="arrows-wrapper">
          <button type="button" class="slick-prev arrows previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="{{ section.settings.arrow_color }}"   stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="slick-next arrows next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 6L15 12L9 18" stroke="{{ section.settings.arrow_color }}"  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="image-grid">
      {% for block in section.blocks %}
        <div class="image-item">
          <img
            src="{{ block.settings.image | img_url: 'master' }}"
            alt="{{ block.settings.image.alt }}"
          >
          {% if block.settings.author != blank %}
            <p class="author">{{ block.settings.author }}</p>
          {% endif %}
          {% if block.settings.designation != blank %}
            <p class="designation">{{ block.settings.designation }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .team-slider-section {
    padding: {{ section.settings.top_padding }}px 20px {{ section.settings.bottom_padding }}px;
  }
  .team-slider-header {
    margin-bottom: 30px;
  }
  .heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .arrows-wrapper {
    display: flex;
    gap: 16px;
    align-items:center;
    justify-content:center;
    padding:0px !important;
  }
  .arrows {
    width: 40px;
    height: 40px;
    background: {{ section.settings.arrow_bg_color }};
    border-radius: 50%;
    display: flex;
    transform:none !important;
    position:static !important;
    align-items: center;
    transition:all 0.3s ease;
    justify-content: center;
    cursor: pointer;
  }
  .arrows:hover,.arrows:focus,.arrows:active{
     background: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_color }};
    opacity:0.8;
  }
  .image-grid {
    display: flex;
    margin: 0 -8px;
  }
  .image-item {
    padding: 0 8px;
    transition: transform 0.3s;
    flex: 1 0 auto;
  }
  .image-item img {
    width: 100%;
    display: block;
  }
  .slick-current .image-item {
    transform: scale(1.1);
  }
  .author {
    margin-top: 4px;
    font-size: 16px;
    font-weight: 600;
    color: #212B36;
    text-align: left;
    margin-bottom:0px !important;

  }
  .designation {
    margin-top: 2px;
    font-size: 14px;
    color: #546A7B;
    text-align: left;
  }
  @media (max-width: 768px) {
    .title {
      font-size: calc({{ section.settings.heading_size }}px * 0.8) !important;
    }
    .overline {
      font-size: calc({{ section.settings.overline_size }}px * 0.8) !important;
    }
    .image-grid {
      overflow: hidden;
    }
  }
</style>

<script>
  $(function(){
    $('.image-grid').slick({
      slidesToShow: {{ section.settings.slides_to_show }},
      slidesToScroll: 1,
      autoplay: true,
      autoplaySpeed: {{ section.settings.autoplay_speed }},
      dots: false,
      swipeToSlide: true,       // ⬅️ Allows partial drag to trigger next
  touchThreshold: 5,        // ⬅️ More sensitive swipe detection
  centerMode: false,        // Set true if you want partial slide centered
      arrows: true,
      prevArrow: $('.slick-prev'),
      nextArrow: $('.slick-next'),
      responsive: [
        { breakpoint: 1024, settings: { slidesToShow: 3 } },
        { breakpoint: 768,  settings: { slidesToShow: 2 } },
        { breakpoint: 480,  settings: { slidesToShow: 1 } }
      ]
    });
  });
</script>

{% schema %}
{
  "name": "Our Team Slider",
  "settings": [
    {
      "type": "text",
      "id": "overline_text",
      "label": "Overline text",
      "default": "Our Team"
    },
    {
      "type": "text",
      "id": "overline_font_family",
      "label": "Overline font family",
      "default": "Arial, sans-serif"
    },
    {
      "type": "range",
      "id": "overline_size",
      "label": "Overline size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "overline_weight",
      "label": "Overline weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 600
    },
    {
      "type": "color",
      "id": "overline_color",
      "label": "Overline color",
      "default": "#546A7B"
    },

    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Meet our Team"
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading font family",
      "default": "Arial, sans-serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (px)",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212B36"
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
     {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background color",
      "default": "#273755"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow  color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top padding (px)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Bottom padding (px)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "slides_to_show",
      "label": "Slides to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (ms)",
      "min": 1000,
      "max": 6000,
      "step": 500,
      "default": 3000
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Jane Doe"
        },
        {
          "type": "text",
          "id": "designation",
          "label": "Role",
          "default": "Co-Founder & CEO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Team Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
