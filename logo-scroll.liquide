{% comment %}
  File: sections/logo-slider.liquid
  Logo slider using Slick.js – Equal vertical alignment for all logos
{% endcomment %}

<section
  class="logo-slider-section"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {% if section.settings.heading_text %}
      <h2
        class="logo-slider__heading"
        style="
          color: {{ section.settings.heading_color }};
          font-family: {{ section.settings.heading_family }};
          font-size: {{ section.settings.heading_size }}px;
          font-weight: {{ section.settings.heading_weight }};
        "
      >
        {{ section.settings.heading_text }}
      </h2>
    {% endif %}

    <div class="logo-slider">
      {% for block in section.blocks %}
        {% if block.settings.logo %}
          <div class="logo-slider__item">
            <div class="logo-wrapper">
              <img
                src="{{ block.settings.logo | img_url: '250x' }}"
                alt="{{ block.settings.logo.alt | escape }}"
              >
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .logo-slider-section {
    overflow: hidden;
  }

  .logo-slider__heading {
    margin-bottom: 1em;
    text-align: left;
  }

  .logo-slider {
    display: none;
    visibility: hidden;
    opacity: 0;
  }

  .slick-initialized.logo-slider {
    opacity: 1;
    visibility: visible;
    animation: fadeIn 1s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .logo-slider__item {
    padding: 0 {{ section.settings.logo_spacing }}px;
    box-sizing: border-box;
  }

  .logo-wrapper {
    height: {{ section.settings.logo_max_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-wrapper img {
    max-height: 100%;
    max-width: 100%;
    height: auto;
    width: auto;
    object-fit: contain;
    display: block;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof jQuery !== 'undefined' && typeof jQuery.fn.slick !== 'undefined') {
      $('.logo-slider').slick({
        slidesToShow: 5,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: {{ section.settings.slider_speed | times: 1000 }},
        infinite: true,
        arrows: false,
        dots: false,
        pauseOnHover: true,
        responsive: [
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 3
            }
          },
          {
            breakpoint: 550,
            settings: {
              slidesToShow: 2
            }
          },
          {
            breakpoint: 400,
            settings: {
              slidesToShow: 1
            }
          }
        ]
      });
    } else {
      console.error("Slick or jQuery not loaded.");
    }
  });
</script>

{% schema %}
{
  "name": "Logo",
  "settings": [
    { "type": "color",   "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "number",  "id": "padding_top",      "label": "Padding top (px)", "default": 40 },
    { "type": "number",  "id": "padding_bottom",   "label": "Padding bottom (px)", "default": 40 },
    { "type": "text",    "id": "heading_text",     "label": "Heading text", "default": "— Our Clients" },
    { "type": "color",   "id": "heading_color",    "label": "Heading color", "default": "#00d1c1" },
    { "type": "text",    "id": "heading_family",   "label": "Heading font-family", "default": "Courier New, Courier, monospace" },
    { "type": "select",  "id": "heading_weight",   "label": "Heading font weight", "options": [{"value":"normal","label":"Normal"},{"value":"bold","label":"Bold"}], "default":"bold" },
    { "type": "number",  "id": "heading_size",     "label": "Heading font size (px)", "default": 14 },
    { "type": "number",  "id": "slider_speed",     "label": "Autoplay speed (seconds)", "default": 3 },
    { "type": "number",  "id": "logo_spacing",     "label": "Logo horizontal padding (px)", "default": 20 },
    { "type": "number",  "id": "logo_max_height",  "label": "Max logo height (px)", "default": 80 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Slider (Equal Alignment)",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
