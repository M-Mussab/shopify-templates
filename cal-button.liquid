{% schema %}
{
  "name": "sticky_call_now",
  "settings": [
    {
      "label": "Lottie animation URL (.json)",
      "id": "lottie_url",
      "type": "url"
    },
    {
      "label": "Text for the button",
      "id": "btn_txt",
      "type": "inline_richtext"
    },
    {
      "label": "Phone number to show on click/hover",
      "id": "phone_num",
      "type": "inline_richtext"
    }
  ]
}
{% endschema %}

<style>
  .call_btn__container {
    position: fixed;
    right: -12px;
    bottom: 50%;
    z-index: 90000;
    transform: rotate(-90deg);
  }
  .call_btn__container .tooltip {
    position: relative;
    display: inline-block;
  }
  .call_btn__container button {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 8px 16px;
    font-size: 1.25rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    background-color: #22e7e7;
    border: none;
    color: #FFFFFF;
    transition: background .2s ease;
  }
  .call_btn__container button:hover {
    background: #1cbfcf;
  }
  .call_btn__container .tooltip .tooltiptext {
    visibility: hidden;
    width: max-content;
    background-color: #f3f3f3;
    color: #333;
    text-align: center;
    border-radius: 4px;
    padding: 8px;
    position: absolute;
    
    bottom: 250%;
    right: -10%;
    transform:rotate(90deg);
    z-index: 90001;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .call_btn__container .tooltip:hover .tooltiptext,
  .call_btn__container .tooltip.active .tooltiptext {
    visibility: visible;
    opacity: 1;
  }
  @media(max-width:500px){
    .call_btn__container{
      display:none;
    }
  }
</style>

<div class="call_btn__container">
  <div class="tooltip">
    {% if section.settings.lottie_url != blank %}
      <script>
        // Load Lottie player if not already loaded
        if (!window.customElements || !customElements.get('lottie-player')) {
          var lottieScript = document.createElement('script');
          lottieScript.src = 'https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js';
          document.head.appendChild(lottieScript);
        }
      </script>
      <lottie-player
        src="{{ section.settings.lottie_url }}"
        background="transparent"
        speed="1"
        style="width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0;"
        loop
        autoplay>
      </lottie-player>
    {% endif %}
    <button type="button" tabindex="0">{{ section.settings.btn_txt }}</button>
    <span class="tooltiptext">{{ section.settings.phone_num }}</span>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.querySelector('.call_btn__container .tooltip');
    var btn = container.querySelector('button');

    // Toggle tooltip on button click
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      container.classList.toggle('active');
    });

    // Hide tooltip when clicking outside
    document.addEventListener('click', function(e) {
      if (!container.contains(e.target)) {
        container.classList.remove('active');
      }
    });
  });
</script>