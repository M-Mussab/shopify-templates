{% comment %}
  sections/video-text.liquid
  — Text on left, video on right with custom play/pause overlay and selectable thumbnail
  — Adjusted for better mobile responsiveness
{% endcomment %}

<section
  class="video-text-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="video-text__container {% if section.settings.heading or section.settings.body_text %}has-text{% endif %} {% if section.settings.video %}has-video{% endif %}">
      {% if section.settings.heading or section.settings.body_text %}
        <div class="video-text__content">
          {% if section.settings.heading %}
            <h2
              class="video-text__heading"
              style="
                font-family: {{ section.settings.heading_font }};
                color: {{ section.settings.heading_color }};
                font-size: {{ section.settings.heading_size }}px;
                font-weight: {{ section.settings.heading_weight }};
                margin-bottom: {{ section.settings.heading_margin_bottom }}px;
              "
            >
              {{ section.settings.heading }}
            </h2>
          {% endif %}
          {% if section.settings.body_text %}
            <div
              class="video-text__body"
              style="
                font-family: {{ section.settings.body_font }};
                color: {{ section.settings.body_color }};
                font-size: {{ section.settings.body_size }}px;
                font-weight: {{ section.settings.body_weight }};
                margin-bottom: {{ section.settings.body_margin_bottom }}px;
              "
            >
              {{ section.settings.body_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.video %}
        {% comment %} determine poster URL {% endcomment %}
        {% if section.settings.thumbnail_image != blank %}
          {% assign poster_url = section.settings.thumbnail_image | img_url: 'master' %}
        {% else %}
          {% assign poster_url = '' %}
        {% endif %}
        <div class="video-text__video-wrapper">
          {%- capture _video -%}
            {{ section.settings.video
               | video_tag:
                 controls: false,
                 muted: section.settings.muted,
                 loop: section.settings.loop,
                 autoplay: false,
                 poster: poster_url
            }}
          {%- endcapture -%}
          {{ _video }}
          <!-- Play/Pause Overlay -->
          <button class="video-play-pause-toggle">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>

  .video-text__heading,
  .video-text__body {
    max-width: 600px;
    text-align: left;
  }
  .video-text__video-wrapper {

    position: relative;
    width: 100%;
    margin-top: 0;
    cursor: pointer;
  }
  .video-text__video-wrapper video {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Fully‑filled teal circle with white border */
  .video-play-pause-toggle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #22E7E7;
    border: 2px solid #ffffff;
    border-radius: 50%;
    cursor: pointer;
    height: 60px;
    width: 60px;
    z-index: 10;
    transition: background 0.3s ease;
    pointer-events: none;
  }
  .video-play-pause-toggle svg {
    width: 24px;
    height: 24px;
    fill: #ffffff;
  }
  .video-text__video-wrapper:hover .video-play-pause-toggle {
    background: #1AC0B0;
  }
  .video-text__video-wrapper.playing .video-play-pause-toggle {
    display: none;
  }
  /* New styles for side-by-side layout */
  .video-text__container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .video-text__content {
    width: 100%;
  }
  .video-text__container.has-text.has-video .video-text__content {
    width: 40%;
    margin-right: 2%;
  }
  .video-text__container.has-text.has-video .video-text__video-wrapper {
    width: 58%;
  }
  @media (max-width: 768px) {
    .video-text__container {
      flex-direction: column;
    }
    .video-text__container.has-text.has-video .video-text__content,
    .video-text__container.has-text.has-video .video-text__video-wrapper {
      width: 100%;
      margin-right: 0;
    }
    .video-text__content {
      margin-bottom: 20px;
    }
    .video-text__heading {
      font-size: 24px !important;
    }
    .video-text__body {
      font-size: 16px !important;
    }
  }
</style>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
  $(function(){
    var $wrapper = $('.video-text__video-wrapper');
    if (!$wrapper.length) return;
    var video = $wrapper.find('video').get(0);
    var $btn   = $wrapper.find('.video-play-pause-toggle');

    function updateOverlay() {
      if (video.paused) {
        $wrapper.removeClass('playing');
        $btn.show();
      } else {
        $wrapper.addClass('playing');
        $btn.hide();
      }
    }

    $wrapper.on('click', function(){
      if (video.paused) video.play();
      else               video.pause();
      updateOverlay();
    });

    video.addEventListener('play',  updateOverlay);
    video.addEventListener('pause', updateOverlay);
    video.addEventListener('ended', updateOverlay);

    updateOverlay();
  });
</script>

{% schema %}
{
  "name": "Video + Text ",
  "settings": [
    { "type": "color",        "id": "bg_color",                 "label": "Section background color",      "default": "#ffffff" },
    { "type": "text",         "id": "heading",                  "label": "Heading text",                 "default": "Your Heading Here" },
    { "type": "text",         "id": "heading_font",             "label": "Heading font‑family",           "default": "Courier New, Courier, monospace" },
    { "type": "color",        "id": "heading_color",            "label": "Heading color",                "default": "#273755" },
    { "type": "number",       "id": "heading_size",             "label": "Heading size (px)",            "default": 36 },
    { "type": "select",       "id": "heading_weight",           "label": "Heading weight",               "options":[
        {"value":"normal","label":"Normal"},{"value":"bold","label":"Bold"},{"value":"bolder","label":"Bolder"}
      ], "default":"bold" },
    { "type": "number",       "id": "heading_margin_bottom",     "label": "Space below heading (px)",     "default": 16 },
    { "type": "richtext",     "id": "body_text",                "label": "Body text",                   "default":"<p>Add your supporting paragraph here.</p>" },
    { "type": "text",         "id": "body_font",                "label": "Body font‑family",             "default": "Courier New, Courier, monospace" },
    { "type": "color",        "id": "body_color",               "label": "Body text color",              "default": "#494949" },
    { "type": "number",       "id": "body_size",                "label": "Body text size (px)",          "default": 18 },
    { "type": "select",       "id": "body_weight",              "label": "Body text weight",             "options":[
        {"value":"normal","label":"Normal"},{"value":"bold","label":"Bold"}
      ], "default":"normal" },
    { "type": "number",       "id": "body_margin_bottom",       "label": "Space below body (px)",        "default": 24 },
    { "type": "video",        "id": "video",                    "label": "Video" },
    { "type": "image_picker", "id": "thumbnail_image",          "label": "Video thumbnail (poster)" },
    { "type": "checkbox",     "id": "muted",                    "label": "Mute video by default",        "default": false },
    { "type": "checkbox",     "id": "loop",                     "label": "Loop video",                  "default": false },
    { "type": "range",        "id": "padding_top",              "label": "Padding top (px)",            "min":0,"max":200,"step":5,"unit":"px","default":40 },
    { "type": "range",        "id": "padding_bottom",           "label": "Padding bottom (px)",         "min":0,"max":200,"step":5,"unit":"px","default":40 }
  ],
  "presets": [
    { "name": "Video + Text with Thumbnail & Overlay" }
  ]
}
{% endschema %}
