    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow Font Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Happy Clients"
    },
    {
      "type": "color",
      "id": "title_text_color",
      "label": "Title Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Hear from our satisfied clients about their experiences."
    },
    {
      "type": "color",
      "id": "description_text_color",
