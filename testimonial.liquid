      "default": "#3a4b4d"
    },
    {
      "type": "color",
      "id": "name_text_color",
      "label": "Testimonial Name Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "name_font_size",
      "label": "Testimonial Name Font Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "position_text_color",
      "label": "Testimonial Position Text Color",
      "default": "#a0a0a0"
    },
    {
      "type": "range",
      "id": "position_font_size",
      "label": "Testimonial Position Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "testimonial_text_color",
      "label": "Testimonial Text Color",
      "default": "#d0d0d0"
    },
    {
      "type": "range",
      "id": "testimonial_font_size",
      "label": "Testimonial Text Font Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Star Rating Settings"
    },
    {
      "type": "color",
      "id": "star_filled_color",
      "label": "Filled Star Color",
      "default": "#FA8443"
    },
    {
