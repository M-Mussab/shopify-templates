      ]
    }
  ]
}
{% endschema %}

<script>
  // This script is unchanged and works correctly with the updated CSS.
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const track = document.getElementById(`testimonials-track-${sectionId}`);

    if (track && track.children.length > 0) {
      const cardCount = track.querySelectorAll('.testimonial-card:not([aria-hidden="true"])').length;
      const duration = Math.max(40, cardCount * 10);
      track.style.animationDuration = `${duration}s`;
    }

    setTimeout(function() {
      const testimonialTexts = document.querySelectorAll(
        `#testimonials-track-${sectionId} .testimonial-card:not([aria-hidden="true"]) .testimonial__text`
      );

      testimonialTexts.forEach(textElement => {
        if (textElement.scrollHeight > textElement.clientHeight) {
          const readMoreBtn = document.createElement('button');
          readMoreBtn.textContent = 'Read More';
          readMoreBtn.className = 'read-more-btn';
          readMoreBtn.setAttribute('aria-expanded', 'false');

          textElement.parentElement.appendChild(readMoreBtn);

          readMoreBtn.addEventListener('click', function() {
            const isExpanded = textElement.classList.toggle('is-expanded');
            this.textContent = isExpanded ? 'Read Less' : 'Read More';
            this.setAttribute('aria-expanded', isExpanded);
          });
        }
      });
    }, 100);
  });
</script>
